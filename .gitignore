# =============================================================================
# Repository policy: what is shared, what is per-box
# =============================================================================
# TRACKED   -> identical on every machine: code, tests, docs, schemas,
#              shared fixtures, and *.example templates.
# IGNORED   -> generated or chosen per machine: secrets, runtime state,
#              caches, logs, databases, personal tree data, IDE/OS settings,
#              and local config overrides.
#
# These rules must live here, in the repo. Do not park box-specific ignores in
# a machine-level excludes file (core.excludesFile / .git/info/exclude): the
# other box would then see the files as untracked and could commit them.
#
# If a file is already tracked, an ignore rule does nothing for it --
# `git rm --cached <path>` is required to drop it from the remote.
# =============================================================================

# --- Secrets and credentials (template kept: .env.example) -------------------
.env
.env.*
!.env.example
.env-*
credentials.enc
**/credentials.enc

# --- Runtime state -----------------------------------------------------------
session_state.json
**/session_state.json
# Written by core/rate_limiter.py. Resolves inside core/cache/ on Windows
# (case-insensitive match with core/Cache) and to a sibling core/Cache on Linux.
**/rate_limiter_state.json

# --- Databases, cookies, personal data --------------------------------------
*.db
*.db-shm
*.db-wal
*.db-journal
Data/chunks_head/
Data/lock
Data/queries.active
Data/wal/
Data/0*
ancestry_cookies.json
**/ancestry_cookies.json
Data/ms_graph_cache.bin
Data/quality_baseline.json
# Personal GEDCOM exports; Data/dummy.ged is the shared fixture.
Data/*.ged
!Data/dummy.ged

# --- Logs --------------------------------------------------------------------
/Logs/
ai/Logs/
*.log
docs/grafana/setup_log.txt

# --- Caches and generated output ---------------------------------------------
/Cache/
/cache/
/archive/
.ruff_cache/
.mypy_cache/
.pyright/
.pytest_cache/
/TestCacheDir_Manager/
htmlcov/
.coverage
.coverage.*
.playwright-mcp/

# --- Python environments and build artefacts ---------------------------------
/venv/
/.venv/
/.venv*/
venv/
__pycache__/
*/__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.so
.Python
*.egg-info/
dist/
build/

# --- IDE and OS --------------------------------------------------------------
/.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Per-box config overrides ------------------------------------------------
# Local, machine-specific config belongs in one of these; none are tracked.
blackbox_mcp_settings.json
docker-compose.override.yml

# --- Local tooling and scratch files -----------------------------------------
/supermemory-mcp/
/backup_before_migration
IMPLEMENTATION_PLAN.md
ai_prompts.bak.*
/ai_prompts.bak.*
*.tmp
*.temp
*~
*.bak
*.backup*
*_temp.py
*_debug.py
